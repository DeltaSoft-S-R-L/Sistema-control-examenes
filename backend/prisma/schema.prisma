generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Examen {
  id          String   @id @default(cuid())
  titulo      String
  descripcion String?
  fecha       DateTime
  creadoEn    DateTime @default(now())
  actualizadoEn DateTime @updatedAt
}
